# GhostBin server configuration — copy to .env and adjust.
# The passphrase is NOT configured here: on first run the browser walks you
# through choosing one (it derives the login key and the E2EE vault key;
# the server never sees it).

# ── Network / TLS ───────────────────────────────────────────────────────
# Bind address for the backend. Default 0.0.0.0 (container-friendly). For a
# bare-metal deploy without a TLS proxy in front, use 127.0.0.1.
# BIND_ADDR=127.0.0.1
# PORT=8788

# Set to your public URL to lock down CORS in production. Without it, the
# server allows all origins (fine for local dev, risky in production).
# Example: ALLOWED_ORIGINS=https://paste.mydomain.com
# ALLOWED_ORIGINS=

# Comma-separated IPs/CIDRs of your reverse proxy. When set, client IPs for
# rate limiting are resolved from X-Forwarded-For (right-to-left). Without
# it the socket peer address is used and the header is ignored.
# Example: TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
# TRUSTED_PROXIES=

# Set to 1 only when the app is served over TLS end-to-end (directly or via
# a TLS-terminating proxy). Adds Strict-Transport-Security.
# HSTS_ENABLED=0

# ── Storage ─────────────────────────────────────────────────────────────
# DATABASE_PATH=./data/ghostbin.sqlite
# UPLOADS_DIR=./data/uploads
# DIST_DIR=./dist

# DANGER: database wipe control.
#   RESET_DB=1     — wipe only an incompatible (old-model) database.
#   RESET_DB=force — wipe even the current schema (e.g. to reclaim an
#                    instance whose setup was squatted). Destroys all data;
#                    back up first.
# RESET_DB=0

# Optional shared secret required to claim a fresh instance via the setup
# dialog. Set it before first exposing the server publicly so a scanner
# cannot squat the one-time setup; leave unset for local dev.
# SETUP_TOKEN=

# ── Limits ──────────────────────────────────────────────────────────────
# Maximum size (bytes) for a text paste's content. Default: 524288 (512 KB).
# MAX_TEXT_SIZE=524288
# Maximum size (bytes) for a single file attachment. Default: 52428800 (50 MB).
# MAX_FILE_SIZE=52428800

RUST_LOG=info
